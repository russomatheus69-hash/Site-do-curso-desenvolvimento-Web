<!DOCTYPE html>
<html lang="pt-br">

<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Meu Site</title>

<style>

body{
  margin: 0;
  font-family: Arial, sans-serif;

  color: white;

  min-height: 100vh;
  overflow-x: hidden;
  overflow-y: auto;

  padding-top: 70px;

  /* fundo gradiente animado */
  background: linear-gradient(180deg, #000000, #0f172a, #14532d, #000000);
  background-size: 400% 400%;
animation: fundoMove 12s ease-in-out infinite;
}

/* MENU SUPERIOR */
.topbar{
  position: fixed;
  top: 0;
  left: 0;

  width: 100%;
  height: 70px;

  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(10px);

  display: flex;
  align-items: center;
  justify-content: center;

  z-index: 999;
}

.topbar a{
  color: white;
  text-decoration: none;

  margin: 0 25px;
  font-size: 18px;
  font-weight: bold;

  transition: 0.3s;
}

.topbar a:hover{
  color: #81CF65;
}

/* LOGIN */
.auth-buttons{
  position: fixed;
  top: 15px;
  right: 80px;
  z-index: 1001;
}

.auth-buttons button{
  background: transparent;
  color: #81CF65;
  border: 1px solid #81CF65;

  padding: 10px 15px;
  margin-left: 5px;

  border-radius: 8px;
  cursor: pointer;
}

.auth-buttons button:hover{
  background: #81CF65;
  color: black;
}

/* FORMULÁRIO */
.formulario{
  display: none;

  position: fixed;
  top: 80px;
  right: 20px;

  width: 300px;

  background: #111827;
  color: white;

  padding: 20px;
  border-radius: 10px;

  box-shadow: 0 0 15px rgba(0,0,0,0.6);

  z-index: 1002;
}

.formulario input{
  width: 100%;
  padding: 10px;
  margin: 8px 0;
  box-sizing: border-box;

  border: none;
  border-radius: 5px;
}

/* TEXTO CENTRAL */
.conteudo{
  position: absolute;
  top: 210px;

  width: 100%;
  text-align: center;

  color: white;
}

/* CARROSSEL */
.carousel,
.carousel2{
  position: absolute;
  width: 100%;
  overflow: hidden;
}

.carousel{
  bottom: 40px;
}

.carousel2{
  bottom: 260px;
}

.carousel-track,
.carousel-track2{
  display: flex;
  width: max-content;
}

.carousel-track{
  animation: slide 20s linear infinite;
}

.carousel-track2{
  animation: slide2 15s linear infinite;
}

/* IMAGENS */
.carousel img,
.carousel2 img{
  width: 300px;
  height: 180px;

  object-fit: cover;

  margin-right: 20px;
  border-radius: 15px;

  box-shadow: 0 4px 10px rgba(0,0,0,0.5);
}

/* MOVIMENTO */
@keyframes slide{
  from{ transform: translateX(0); }
  to{ transform: translateX(-50%); }
}

@keyframes slide2{
  from{ transform: translateX(-50%); }
  to{ transform: translateX(0); }
}

@keyframes fundoMove{
  0%{
    background-position: 50% 0%;
  }
  50%{
    background-position: 50% 100%;
  }
  100%{
    background-position: 50% 0%;
  }
}


</style>

</head>

<body>

</style>

</style>

</style>
</head>

<body>

<!-- MENU SUPERIOR -->
<div class="topbar">
  <a href="sobre-o-curso.html">Sobre</a>
  <a href="sobre-professores.html">Professores</a>
  <a href="#">Modalidades</a>
  <a href="#">Níveis</a>
  <a href="#">Matrículas</a>
  <a href="#">Contato</a>
</div>

<!-- BOTÕES LOGIN E CADASTRO -->
<div class="auth-buttons">
  <button onclick="mostrarFormulario('login')">Login</button>
  <button onclick="mostrarFormulario('cadastro')">Cadastro</button>
</div>

<!-- FORMULÁRIO LOGIN -->
<div id="login" class="formulario">
  <h3>Login</h3>

  <input type="email" placeholder="E-mail">
  <input type="password" placeholder="Senha">

  <button>Entrar</button>
</div>

<!-- FORMULÁRIO CADASTRO -->
<div id="cadastro" class="formulario">
  <h3>Cadastro</h3>

  <input type="text" placeholder="Nome">
  <input type="email" placeholder="E-mail">
  <input type="password" placeholder="Senha">

  <button>Cadastrar</button>
</div>

<!-- TEXTO CENTRAL -->
<div class="conteudo">
  <h1>O CURSO</h1>
  <p>Matricule-se ja</p>
</div>

<!-- SEGUNDO CARROSSEL -->
<div class="carousel2">
  <div class="carousel-track2">

    <img src="omnitrix.jpg">
    <img src="feedback.png">
    <img src="ben10.jpg">
    <img src="aliens.jpg">
    <img src="Alienxx.webp">
    <img src="4bracos.jpg">

    <img src="imagenchama.jpg">
    <img src="EcoEcoAberturaFA2.webp">
    <img src="aliens.png">
    <img src="Aliens2.png">
    <img src="Alienxx.webp">

  </div>
</div>

<!-- PRIMEIRO CARROSSEL -->
<div class="carousel">
  <div class="carousel-track">

    <img src="imagenchama.jpg">
    <img src="EcoEcoAberturaFA2.webp">
    <img src="aliens.png">
    <img src="aliens2.webp">
    <img src="Enormossaaaaaaaaaaaaaaaaaaauro.jpg">
    <img src="Alienxx.webp">
    <img src="friagem.jpg">

    <img src="imagenchama.jpg">
    <img src="EcoEcoAberturaFA2.webp">
    <img src="aliens.png">
    <img src="aliens2.webp">
    <img src="friagem2.jpg">
    <img src="Alienxx.webp">
    <img src="friagem.jpg">

  </div>
</div>

<script>

function mostrarFormulario(tipo){

  const formulario = document.getElementById(tipo);

  // Se já estiver aberto, fecha
  if(formulario.style.display === "block"){
    formulario.style.display = "none";
    return;
  }

  // Fecha os dois
  document.getElementById("login").style.display = "none";
  document.getElementById("cadastro").style.display = "none";

  // Abre o selecionado
  formulario.style.display = "block";
}

</script>

</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">

<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>

body{
  margin: 0;
  font-family: Arial, sans-serif;

  background-image: url('fundoverde.avif');
  background-size: cover;
  background-position: center;
  height: 100vh;
  overflow: hidden;

  padding-top: 70px;
}

/* MENU SUPERIOR */
.topbar{
  position: fixed;
  top: 0;
  left: 0;

  width: 100%;
  height: 70px;

  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(10px);

  display: flex;
  align-items: center;
  justify-content: center;

  z-index: 999;
}

.topbar a{
  color: white;
  text-decoration: none;

  margin: 0 25px;
  font-size: 18px;
  font-weight: bold;

  transition: 0.3s;
}

.topbar a:hover{
  color: #81CF65;
}

/* TEXTO CENTRAL */
.conteudo{
  position: absolute;
  top: 210px;

  width: 100%;
  text-align: center;

  color: white;

  text-shadow: 2px 2px 6px rgba(0,0,0,0.8);
}

.conteudo h1{
  font-size: 42px;
  margin-bottom: 10px;
}

.conteudo p{
  font-size: 18px;
  max-width: 600px;
  margin: 0 auto;
}

/* CARDS */
.cards{
  position: absolute;
  top: 110px;

  width: 100%;
  display: flex;
  justify-content: center;

  gap: 310px;
}

.card{
  text-align: center;
  width: 320px;
}

.card img{
  width: 100%;
  height: 260px;

  object-fit: cover;

  border-radius: 15px;

  box-shadow: 0 6px 15px rgba(0,0,0,0.6);

  transition: 0.3s;
}

.card img:hover{
  transform: scale(1.05);
}

/* TEXTO ABAIXO DAS IMAGENS */
.card h3{
  color: #81CF65;
  margin-top: 12px;
  font-size: 20px;
}

.card p{
  color: white;
  margin-top: 5px;
  font-size: 16px;
}

</style>
</head>

<body>

<div class="topbar">

  <a href="index-site-do-curso.html">Inicio</a>
  <a href="#">Professores</a>
  <a href="#">Modalidades</a>
  <a href="#">Contato</a>

</div>

<!-- IMAGENS -->
<div class="cards">

  <div class="card">
    <img src="4bracos.jpg">
    <h3>Sobre Nós</h3>
    <p>Força bruta alienígena</p>
  </div>

  <div class="card">
    <img src="Alienxx.webp">
    <h3>Metodologia</h3>
    <p>Poder cósmico supremo</p>
  </div>

  <div class="card">
    <img src="friagem.jpg">
    <h3>metodo de trabalho</h3>
    <p>Controle absoluto do gelo</p>
  </div>

</div>

</body>
</html>
